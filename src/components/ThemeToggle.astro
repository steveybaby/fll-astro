---
// Theme toggle component - no props needed
---

<button
  id="theme-toggle"
  aria-label="Toggle theme mode"
  title="Toggle between light, dark, and glow mode"
  class="theme-toggle"
>
  <svg class="sun-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
    <circle cx="12" cy="12" r="5" stroke="currentColor" stroke-width="2"/>
    <path d="M12 1v6m0 6v6m11-7h-6m-6 0H1" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
  </svg>
  <svg class="moon-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
    <path d="M21 12.79A9 9 0 1 1 11.21 3 A7 7 0 0 0 21 12.79z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
  </svg>
  <div class="glow-icon">✨</div>
</button>

<script>
  const toggle = document.getElementById('theme-toggle');

  function setTheme(theme: string) {
    document.documentElement.dataset.theme = theme;
    localStorage.setItem('theme', theme);
  }

  // Spore drift animation functions
  function startSpores() {
    // Create spore field container if it doesn't exist
    let rainContainer = document.getElementById('spore-field');
    if (!rainContainer) {
      rainContainer = document.createElement('div');
      rainContainer.id = 'spore-field';
      rainContainer.className = 'spore-field';
      document.body.appendChild(rainContainer);
    }

    // Clear any existing spores
    rainContainer.innerHTML = '';

    // Start creating drifting spores
    const createSpore = () => {
      const spore = document.createElement('div');
      spore.className = 'spore';
      spore.textContent = '✦';
      spore.style.left = Math.random() * 100 + 'vw';
      spore.style.animationDuration = (Math.random() * 3 + 2) + 's'; // 2-5 seconds
      spore.style.animationDelay = Math.random() * 2 + 's';
      rainContainer.appendChild(spore);

      // Remove spore after animation
      setTimeout(() => {
        if (spore.parentNode) {
          spore.parentNode.removeChild(spore);
        }
      }, 7000);
    };

    // Create initial burst of spores
    for (let i = 0; i < 15; i++) {
      setTimeout(createSpore, i * 200);
    }

    // Continue creating spores at intervals
    window.sporeInterval = setInterval(createSpore, 500);
  }

  function stopSpores() {
    // Stop creating new spores
    if (window.sporeInterval) {
      clearInterval(window.sporeInterval);
      window.sporeInterval = null;
    }

    // Remove existing spores with fade out
    const rainContainer = document.getElementById('spore-field');
    if (rainContainer) {
      rainContainer.style.opacity = '0';
      setTimeout(() => {
        if (rainContainer.parentNode) {
          rainContainer.parentNode.removeChild(rainContainer);
        }
      }, 1000);
    }
  }

  toggle?.addEventListener('click', () => {
    const current = document.documentElement.dataset.theme || 'light';
    let next: string;

    switch (current) {
      case 'light':
        next = 'dark';
        break;
      case 'dark':
        next = 'glow';
        break;
      case 'glow':
      default:
        next = 'light';
        break;
    }

    setTheme(next);

    // Toggle spore drift animation
    if (next === 'glow') {
      startSpores();
    } else {
      stopSpores();
    }
  });

  // Make functions globally available
  window.startSpores = startSpores;
  window.stopSpores = stopSpores;
</script>

<style>
  .theme-toggle {
    background: none;
    border: none;
    padding: calc(var(--grid-unit));
    cursor: pointer;
    color: var(--color-text-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: color 0.2s ease;
  }

  .theme-toggle:hover {
    color: var(--color-accent);
  }

  .glow-icon {
    font-size: 18px;
    line-height: 1;
    display: none;
  }

  /* Show/hide icons based on theme */
  [data-theme="light"] .moon-icon,
  [data-theme="light"] .glow-icon,
  [data-theme="dark"] .sun-icon,
  [data-theme="dark"] .glow-icon,
  [data-theme="glow"] .sun-icon,
  [data-theme="glow"] .moon-icon {
    display: none;
  }

  [data-theme="glow"] .glow-icon {
    display: block;
    animation: bounce 0.6s ease-in-out infinite alternate;
  }

  @keyframes bounce {
    from { transform: translateY(0px); }
    to { transform: translateY(-3px); }
  }

  /* Spore field styles */
  :global(.spore-field) {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    pointer-events: none;
    z-index: 9999;
    opacity: 1;
    transition: opacity 1s ease-out;
  }

  :global(.spore) {
    position: absolute;
    top: -40px;
    font-size: 20px;
    line-height: 1;
    color: var(--bio-light-green);
    text-shadow: 0 0 12px rgba(195, 227, 154, 0.9);
    animation: drift linear forwards;
    pointer-events: none;
  }

  @keyframes drift {
    from { transform: translateY(-40px) translateX(0); opacity: 0; }
    10%  { opacity: 1; }
    to   { transform: translateY(calc(100vh + 40px)) translateX(40px); opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.spore-field) { display: none; }
    .glow-icon { animation: none; }
  }
</style>
