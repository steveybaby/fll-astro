---
import Layout from './Layout.astro';
import { getSeasonContent } from '../utils/season';
import { getSeason, CURRENT_SEASON } from '../config/season';

export interface Props {
  season?: string;
}

const { season = CURRENT_SEASON } = Astro.props;

const seasonInfo = getSeason(season);
/** '' for the live season, '/2025' for an archived one. */
const prefix = seasonInfo.archived && seasonInfo.archivePath ? seasonInfo.archivePath : '';

const newsletters = (await getSeasonContent('newsletter', season)).filter(
  ({ data }) => !data.draft
);

// Sort newsletters by date (newest first)
newsletters.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Layout
  title="Team Newsletters"
  description={`${seasonInfo.teamName} team newsletters and updates for parents and team members`}
  season={season}
>
  <div class="newsletters-page">
    <header class="page-header">
      <h1>Team Newsletters</h1>
      <p class="page-description">
        Stay up to date with our FLL team progress, important announcements, and upcoming events.
      </p>
    </header>

    <div class="newsletters-grid">
      {newsletters.map((newsletter) => (
        <article class="newsletter-card">
          <div class="newsletter-meta">
            <time datetime={newsletter.data.date.toISOString()}>
              {newsletter.data.date.toLocaleDateString('en-US', {
                year: 'numeric',
                month: 'long',
                day: 'numeric'
              })}
            </time>
            <span class="newsletter-author">by {newsletter.data.author}</span>
          </div>
          
          <h2>
            <a href={`${prefix}/newsletters/${newsletter.slug}/`} class="newsletter-link">
              {newsletter.data.title}
            </a>
          </h2>
          
          {newsletter.data.excerpt && (
            <p class="newsletter-excerpt">{newsletter.data.excerpt}</p>
          )}
          
          {newsletter.data.tags && newsletter.data.tags.length > 0 && (
            <div class="newsletter-tags">
              {newsletter.data.tags.map((tag) => (
                <span class="tag">{tag}</span>
              ))}
            </div>
          )}
          
          <a href={`${prefix}/newsletters/${newsletter.slug}/`} class="read-more-btn">
            Read Full Newsletter →
          </a>
        </article>
      ))}
    </div>

    {newsletters.length === 0 && (
      <div class="no-newsletters">
        <p>No newsletters published yet. Check back soon!</p>
      </div>
    )}
  </div>
</Layout>

<style>
  .newsletters-page {
    max-width: 900px;
    margin: 0 auto;
    padding: var(--space-l) 0;
  }

  .page-header {
    text-align: center;
    margin-bottom: var(--space-xl);
  }

  .page-header h1 {
    font-family: var(--font-heading-primary);
    font-size: 3rem;
    font-weight: 900;
    color: var(--color-accent);
    margin: 0 0 var(--space-s) 0;
  }

  .page-description {
    font-size: var(--step-0);
    color: var(--color-text-secondary);
    line-height: 1.6;
    max-width: 600px;
    margin: 0 auto;
  }

  .newsletters-grid {
    display: grid;
    gap: var(--space-l);
  }

  .newsletter-card {
    background: var(--color-surface);
    border: 2px solid var(--color-border);
    border-radius: var(--radius-m);
    padding: var(--space-l);
    transition: all var(--dur-fast) var(--ease-out);
  }

  .newsletter-card:hover {
    border-color: var(--color-accent);
    transform: translateY(-2px);
    box-shadow: var(--shadow-m);
  }

  .newsletter-meta {
    display: flex;
    align-items: center;
    gap: var(--space-s);
    margin-bottom: var(--space-s);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--color-text-muted);
  }

  .newsletter-meta time {
    font-weight: 600;
  }

  .newsletter-card h2 {
    font-family: var(--font-heading-secondary);
    font-size: 1.75rem;
    font-weight: 700;
    margin: 0 0 var(--space-s) 0;
    line-height: 1.2;
  }

  .newsletter-link {
    color: var(--color-text-primary);
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease-out);
  }

  .newsletter-link:hover {
    color: var(--color-accent);
  }

  .newsletter-excerpt {
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin-bottom: var(--space-m);
    font-size: 1.1rem;
  }

  .newsletter-tags {
    display: flex;
    flex-wrap: wrap;
    gap: calc(var(--grid-unit));
    margin-bottom: var(--space-m);
  }

  .tag {
    background: var(--color-accent);
    color: var(--color-accent-contrast);
    font-family: var(--font-mono);
    font-size: var(--step--2);
    font-weight: 600;
    padding: calc(var(--grid-unit) / 2) calc(var(--grid-unit));
    border-radius: var(--radius-pill);
    text-transform: uppercase;
    letter-spacing: 0.18em;
  }

  .read-more-btn {
    display: inline-block;
    font-family: var(--font-body);
    font-weight: 700;
    color: var(--color-accent);
    text-decoration: none;
    padding: calc(var(--grid-unit)) var(--space-s);
    border: 2px solid var(--color-accent);
    border-radius: var(--radius-s);
    transition: all var(--dur-fast) var(--ease-out);
    font-size: var(--step--1);
  }

  .read-more-btn:hover,
  .read-more-btn:focus {
    background: var(--color-accent);
    color: var(--color-accent-contrast);
    transform: translateY(-1px);
  }

  .no-newsletters {
    text-align: center;
    padding: var(--space-xl);
    color: var(--color-text-muted);
    font-style: italic;
  }

  @media (max-width: 768px) {
    .newsletters-page {
      padding: var(--space-m) var(--content-padding);
    }

    .page-header h1 {
      font-size: 2.25rem;
    }

    .newsletter-card {
      padding: var(--space-m);
    }

    .newsletter-card h2 {
      font-size: var(--step-1);
    }

    .newsletter-meta {
      flex-direction: column;
      align-items: flex-start;
      gap: calc(var(--grid-unit) / 2);
    }
  }
</style>
