---
import Layout from './Layout.astro';
import { getSeasonContent } from '../utils/season';
import { getSeason, CURRENT_SEASON } from '../config/season';

export interface Props {
  newsletter: any;
  season?: string;
}

const { newsletter, season = CURRENT_SEASON } = Astro.props;

const seasonInfo = getSeason(season);
/** '' for the live season, '/2025' for an archived one. */
const prefix = seasonInfo.archived && seasonInfo.archivePath ? seasonInfo.archivePath : '';
const newslettersIndexHref = `${prefix}/newsletters/`;

const { Content } = await newsletter.render();

// Get other newsletters from the same season for navigation
const allNewsletters = (await getSeasonContent('newsletter', season)).filter(
  ({ data }) => !data.draft
);
allNewsletters.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const currentIndex = allNewsletters.findIndex((n) => n.slug === newsletter.slug);
const prevNewsletter =
  currentIndex < allNewsletters.length - 1 ? allNewsletters[currentIndex + 1] : null;
const nextNewsletter = currentIndex > 0 ? allNewsletters[currentIndex - 1] : null;
---

<Layout 
  title={newsletter.data.title}
  description={newsletter.data.description || newsletter.data.excerpt}
  type="article"
  publishedTime={newsletter.data.date.toISOString()}
  season={season}
>
  <article class="newsletter-article">
    <header class="newsletter-header">
      <h1>{newsletter.data.title}</h1>
      
      <div class="newsletter-meta">
        <div class="newsletter-date-author">
          <time datetime={newsletter.data.date.toISOString()}>
            {newsletter.data.date.toLocaleDateString('en-US', {
              weekday: 'long',
              year: 'numeric',
              month: 'long',
              day: 'numeric'
            })}
          </time>
          <span class="newsletter-author">by {newsletter.data.author}</span>
        </div>
        
        <div class="newsletter-actions">
          <a href={newslettersIndexHref} class="back-to-newsletters">
            ← All Newsletters
          </a>
        </div>
      </div>
      
      {newsletter.data.tags && newsletter.data.tags.length > 0 && (
        <div class="newsletter-tags">
          {newsletter.data.tags.map((tag) => (
            <span class="tag">{tag}</span>
          ))}
        </div>
      )}
    </header>

    <!-- Quick Navigation Links -->
    <div class="quicklinks">
      {prevNewsletter && (
        <a href={`${prefix}/newsletters/${prevNewsletter.slug}/`} 
           class="quicklink prev-quicklink" 
           title={`Previous: ${prevNewsletter.data.title}`}>
          ← Previous
        </a>
      )}
      {nextNewsletter && (
        <a href={`${prefix}/newsletters/${nextNewsletter.slug}/`} 
           class="quicklink next-quicklink" 
           title={`Next: ${nextNewsletter.data.title}`}>
          Next →
        </a>
      )}
    </div>

    <div class="newsletter-content">
      <Content />
    </div>

    <!-- Newsletter Navigation -->
    <nav class="newsletter-nav">
      <div class="newsletter-pagination">
        {prevNewsletter && (
          <a href={`${prefix}/newsletters/${prevNewsletter.slug}/`} class="nav-link prev-newsletter">
            <span class="nav-label">Previous Newsletter</span>
            <span class="nav-title">{prevNewsletter.data.title}</span>
            <span class="nav-date">
              {prevNewsletter.data.date.toLocaleDateString('en-US', {
                month: 'short',
                day: 'numeric',
                year: 'numeric'
              })}
            </span>
          </a>
        )}
        
        {nextNewsletter && (
          <a href={`${prefix}/newsletters/${nextNewsletter.slug}/`} class="nav-link next-newsletter">
            <span class="nav-label">Next Newsletter</span>
            <span class="nav-title">{nextNewsletter.data.title}</span>
            <span class="nav-date">
              {nextNewsletter.data.date.toLocaleDateString('en-US', {
                month: 'short',
                day: 'numeric',
                year: 'numeric'
              })}
            </span>
          </a>
        )}
      </div>
      
      <a href={newslettersIndexHref} class="back-link">View All Newsletters</a>
    </nav>
  </article>
</Layout>

<style>
  .newsletter-article {
    max-width: 800px;
    margin: 0 auto var(--space-xl) auto;
  }

  .newsletter-header {
    margin-bottom: var(--space-xl);
  }

  .newsletter-header h1 {
    font-family: var(--font-heading-primary);
    font-size: 3rem;
    font-weight: 900;
    color: var(--color-accent);
    line-height: 1.1;
    margin: 0 0 var(--space-m) 0;
  }

  .newsletter-meta {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-s);
    margin-bottom: var(--space-m);
  }

  .newsletter-date-author {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
    flex: 1;
  }

  .newsletter-date-author time {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.18em;
    font-weight: 600;
  }

  .newsletter-author {
    font-family: var(--font-heading-secondary);
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--color-text-secondary);
  }

  .newsletter-actions {
    flex-shrink: 0;
  }

  .back-to-newsletters {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--color-text-muted);
    text-decoration: none;
    padding: var(--space-3xs) var(--space-2xs);
    border-radius: var(--radius-s);
    transition: all var(--dur-fast) var(--ease-out);
  }

  .back-to-newsletters:hover {
    color: var(--color-accent);
    background-color: var(--color-surface);
  }

  .newsletter-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
  }

  .tag {
    background: var(--color-accent);
    color: var(--color-accent-contrast);
    font-family: var(--font-mono);
    font-size: var(--step--2);
    font-weight: 600;
    padding: var(--space-3xs) var(--space-2xs);
    border-radius: 12px;
    text-transform: uppercase;
    letter-spacing: 0.18em;
  }

  .quicklinks {
    display: flex;
    justify-content: space-between;
    margin: var(--space-s) 0 var(--space-l) 0;
    padding: 0 var(--space-s);
  }

  .quicklink {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    font-weight: 600;
    color: var(--color-text-muted);
    text-decoration: none;
    padding: var(--space-3xs) var(--space-2xs);
    border-radius: var(--radius-s);
    transition: all var(--dur-fast) var(--ease-out);
  }

  .quicklink:hover {
    color: var(--color-accent);
    background-color: var(--color-surface);
  }

  .prev-quicklink {
    margin-right: auto;
  }

  .next-quicklink {
    margin-left: auto;
  }

  .newsletter-header::after {
    content: "";
    height: 6px;
    background-color: var(--color-accent);
    border: none;
    margin: var(--space-l) 0;
    width: 100%;
    display: block;
  }

  .newsletter-content {
    font-size: var(--step-0);
    line-height: 1.7;
    margin-bottom: var(--space-xl);
  }

  .newsletter-content :global(h1) {
    font-family: var(--font-heading-primary);
    font-size: var(--step-3);
    font-weight: 700;
    color: var(--color-text-primary);
    margin-top: var(--space-xl);
    margin-bottom: var(--space-m);
  }

  .newsletter-content :global(h2) {
    font-family: var(--font-heading-secondary);
    font-size: var(--step-3);
    font-weight: 700;
    color: var(--color-text-primary);
    margin-top: var(--space-xl);
    margin-bottom: var(--space-m);
  }

  .newsletter-content :global(h3) {
    font-family: var(--font-heading-secondary);
    font-size: var(--step-1);
    font-weight: 600;
    color: var(--color-text-primary);
    margin-top: var(--space-l);
    margin-bottom: var(--space-s);
  }

  .newsletter-content :global(ul),
  .newsletter-content :global(ol) {
    margin-bottom: var(--space-m);
    padding-left: var(--space-m);
  }

  .newsletter-content :global(li) {
    margin-bottom: var(--space-3xs);
  }

  .newsletter-content :global(p) {
    margin-bottom: var(--space-m);
  }

  .newsletter-content :global(strong) {
    font-weight: 600;
    color: var(--color-accent);
  }

  .newsletter-content :global(em) {
    font-style: italic;
  }

  .newsletter-nav {
    border-top: 1px solid var(--color-border);
    padding-top: var(--space-m);
    margin-top: var(--space-xl);
  }

  .newsletter-pagination {
    display: flex;
    justify-content: space-between;
    gap: var(--space-s);
    margin-bottom: var(--space-m);
  }

  .nav-link {
    flex: 1;
    max-width: 300px;
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
    padding: var(--space-s);
    background: var(--color-surface);
    border: 2px solid var(--color-border);
    border-radius: var(--radius-m);
    text-decoration: none;
    transition: all var(--dur-fast) var(--ease-out);
  }

  .nav-link:hover {
    border-color: var(--color-accent);
    transform: translateY(-2px);
    box-shadow: var(--shadow-m);
  }

  .prev-newsletter {
    text-align: left;
  }

  .next-newsletter {
    text-align: right;
    margin-left: auto;
  }

  .nav-label {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.18em;
    font-weight: 600;
  }

  .nav-title {
    font-family: var(--font-heading-secondary);
    font-size: var(--step--1);
    font-weight: 700;
    color: var(--color-text-primary);
    line-height: 1.2;
  }

  .nav-link:hover .nav-title {
    color: var(--color-accent);
  }

  .nav-date {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.18em;
  }

  .back-link {
    font-family: var(--font-body);
    font-weight: 700;
    color: var(--color-accent);
    padding: var(--space-2xs) var(--space-s);
    border: 2px solid var(--color-accent);
    border-radius: var(--radius-s);
    transition: all var(--dur-fast) var(--ease-out);
    display: inline-block;
    text-decoration: none;
  }

  .back-link:hover,
  .back-link:focus {
    background-color: var(--color-accent);
    color: var(--color-accent-contrast);
    text-decoration: none;
  }

  @media (max-width: 768px) {
    .newsletter-header h1 {
      font-size: 2.25rem;
    }

    .newsletter-content {
      font-size: var(--step--1);
    }

    .newsletter-content :global(h1) {
      font-size: var(--step-3);
    }

    .newsletter-content :global(h2) {
      font-size: 1.75rem;
    }

    .newsletter-content :global(h3) {
      font-size: var(--step-0);
    }

    .newsletter-pagination {
      flex-direction: column;
      gap: var(--space-xs);
    }

    .nav-link {
      max-width: none;
    }

    .next-newsletter {
      margin-left: 0;
    }

    .nav-title {
      font-size: var(--step--1);
    }

    .quicklinks {
      margin: var(--space-xs) 0 var(--space-m) 0;
      padding: 0 var(--space-2xs);
    }

    .quicklink {
      font-size: var(--step--2);
      padding: var(--space-3xs);
    }

    .newsletter-meta {
      flex-direction: column;
      gap: var(--space-xs);
      align-items: flex-start;
    }

    .newsletter-actions {
      align-self: stretch;
    }

    .back-to-newsletters {
      width: 100%;
      text-align: center;
    }
  }
</style>
