---
import { getSeasonContent } from '../../utils/season';
import { deriveMilestones } from '../../utils/timeline';

const meetings = await getSeasonContent('meetings');
const milestones = deriveMilestones(
  meetings.map((m) => ({ slug: m.slug, data: m.data as any }))
);

const doneCount = milestones.filter((m) => m.done).length;

// Dots sit inside a `grid-auto-columns: 1fr` track and are left-aligned
// within their column (not centred), so dot i lands at (i / n) * 100% of the
// rail's width, not at i / (n - 1) * 100% as an evenly-spaced 0/25/50/75/100%
// layout would suggest. The fill bar and the grey track behind it both need
// to target that same i/n position — the fill so it terminates on the last
// completed dot, and the track so it doesn't run past the final dot into
// empty space.
const trackEndPercent = milestones.length > 0 ? ((milestones.length - 1) / milestones.length) * 100 : 0;
const fillPercent =
  milestones.length > 1 && doneCount > 0 ? ((doneCount - 1) / milestones.length) * 100 : 0;
---

{milestones.length > 0 && (
  <section class="timeline" aria-labelledby="timeline-heading">
    <div class="timeline__inner">
      <h2 id="timeline-heading" class="timeline__heading" data-reveal>Key dates</h2>

      <ol class="timeline__rail" style={`--fill:${fillPercent}%; --track-end:${trackEndPercent}%`}>
        {milestones.map((m, i) => (
          <li class:list={['timeline__stop', { 'is-done': m.done }]} data-reveal data-reveal-delay={String(Math.min(i + 1, 4))}>
            <a href={`/meetings/${m.slug}/`} class="timeline__link">
              <span class="timeline__dot" aria-hidden="true"></span>
              <span class="sr-only">{m.done ? 'Completed: ' : 'Upcoming: '}</span>
              <span class="timeline__label">{m.label}</span>
              <time class="timeline__date" datetime={m.date.toISOString().slice(0, 10)}>
                {m.date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', timeZone: 'UTC' })}
              </time>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>
)}

<style>
  .timeline { padding: var(--space-2xl) 0; }

  .timeline__inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 var(--content-padding);
  }

  .timeline__heading { margin-bottom: var(--space-l); }

  .timeline__rail {
    list-style: none;
    padding: var(--space-s) 0 0;
    margin: 0;
    display: grid;
    gap: var(--space-s);
    position: relative;
  }

  .timeline__stop {
    margin: 0;
    position: relative;
  }

  /* Vertical rail joining each dot to the next. Without it the stacked layout
     reads as a bulleted list, not a timeline — the connector is the thing that
     makes a row of dots a sequence. The horizontal rail below replaces this at
     wider widths. */
  .timeline__stop:not(:last-child)::before {
    content: '';
    position: absolute;
    left: 5px;
    width: 2px;
    top: calc(0.34em + 14px);
    bottom: calc((var(--space-s) + 0.34em) * -1);
    background-color: var(--color-border);
    border-radius: 1px;
  }

  /* A segment counts as travelled once the stop BELOW it is done. */
  .timeline__stop:has(+ .is-done)::before {
    background-color: var(--color-accent);
  }

  /* A two-column grid rather than a flex row: labels run from one word to
     three, and as a flex row a wrapping label squeezes the date into a sliver
     beside it. Explicit placement keeps the date on its own line under the
     label no matter how the label wraps. */
  .timeline__link {
    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: var(--space-2xs);
    row-gap: 2px;
    align-items: start;
    text-decoration: none;
    color: var(--color-text-secondary);
  }

  .timeline__dot {
    grid-column: 1;
    grid-row: 1;
    box-sizing: border-box;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background-color: transparent;
    border: 2px solid var(--color-border);
    /* Pinned to the first line rather than the shared baseline, so the rail
       above and below it lines up predictably even when the label wraps. */
    margin-top: 0.34em;
    transition: background-color var(--dur-base) var(--ease-out), border-color var(--dur-base) var(--ease-out);
  }

  /* Done vs upcoming is conveyed by shape (filled vs hollow), not colour alone. */
  .is-done .timeline__dot {
    background-color: var(--color-action);
    border-color: var(--color-action);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--color-action) 25%, transparent);
  }

  .timeline__label {
    grid-column: 2;
    grid-row: 1;
    font-family: var(--font-heading-primary);
    font-weight: 700;
    line-height: 1.25;
    color: var(--color-accent);
  }

  .timeline__date {
    grid-column: 2;
    grid-row: 2;
    font-family: var(--font-label);
    font-size: var(--step--2);
    color: var(--color-text-muted);
  }

  /* Horizontal rail once there is room for one. The vertical connectors are
     retired here — the ::before/::after pair on the rail takes over. */
  @media (min-width: 760px) {
    .timeline__stop:not(:last-child)::before {
      content: none;
    }

    .timeline__rail {
      grid-auto-flow: column;
      grid-auto-columns: 1fr;
      gap: 0;
      padding-top: var(--space-m);
    }

    .timeline__rail::before,
    .timeline__rail::after {
      content: '';
      position: absolute;
      top: var(--space-m);
      height: 3px;
      border-radius: 2px;
    }

    .timeline__rail::before {
      left: 0;
      width: var(--track-end, 100%);
      background-color: var(--color-border);
    }

    .timeline__rail::after {
      left: 0;
      width: var(--fill, 0%);
      background-color: var(--color-accent);
      transition: width var(--dur-slow) var(--ease-out);
    }

    /* One column here: dot, then label, then date, stacked. */
    .timeline__link {
      grid-template-columns: 1fr;
      row-gap: var(--space-3xs);
      padding-right: var(--space-s);
    }

    .timeline__dot {
      grid-column: 1;
      grid-row: 1;
      margin-top: -6px;
    }

    .timeline__date {
      grid-column: 1;
      grid-row: 3;
    }

    /* Labels vary from one word to three, so reserve two lines. Without this
       the dates sit at different heights depending on whether their label
       wrapped, and the row reads as ragged. */
    .timeline__label {
      grid-column: 1;
      grid-row: 2;
      line-height: 1.25;
      min-height: 2.5em;
    }

    .timeline__dot {
      align-self: auto;
      margin-top: -6px;
    }
  }
</style>
