---
import type { GetStaticPaths } from 'astro';
import NewsletterDetail from '../../components/NewsletterDetail.astro';
import { getSeasonContent } from '../../utils/season';
import { CURRENT_SEASON } from '../../config/season';

export const getStaticPaths: GetStaticPaths = async () => {
  const newsletters = await getSeasonContent('newsletter');
  return newsletters.map((newsletter) => ({
    params: { slug: newsletter.slug },
    props: { newsletter },
  }));
};

const { newsletter } = Astro.props;
---

<NewsletterDetail newsletter={newsletter} season={CURRENT_SEASON} />
