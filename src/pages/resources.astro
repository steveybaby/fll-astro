---
import Layout from '../components/Layout.astro';
import { getCurrentSeason } from '../config/season';

const season = getCurrentSeason();
---

<Layout title="FLL Resources" description={`Comprehensive collection of FIRST LEGO League ${season.challenge}™ season resources, including official guides, robot programming tools, and educational materials.`}>
  <div class="resources-page">
    <!-- Hero Banner -->
    <div class="banner">
      <h1>🏆 FLL {season.challenge}™ Season Resources</h1>
      <p class="banner-text">
        <a href="https://www.firstinspires.org/resource-library/fll/challenge/challenge-and-resources" target="_blank" rel="noopener">
          🔗 OFFICIAL FLL CHALLENGE & RESOURCES 🔗
        </a>
      </p>
    </div>


    <!-- Resources Grid -->
    <div class="resources">
      <section class="resource-section">
        <h2>📋 General Participation</h2>
        <ul class="resource-list">
          <li><a href="https://firstinspires.blob.core.windows.net/fll/challenge/2026-27/fll-challenge-bioglow-participation-rules.pdf" target="_blank">Participation Rules</a> - Rules and requirements for participating in FIRST LEGO League events</li>
          <li><a href="https://drive.google.com/file/d/1fOU9S4MvaMfxEhEQgodrbr0RNduwFCIb/view" target="_blank">Systems Flowchart</a> - Team, Event, Volunteer Registration guide</li>
          <li><a href="https://docs.google.com/presentation/d/1nFXz6UaNS1u6l3MYtT1AiZZHcRHkyUzDXeJlXl7EKAU/edit?slide=id.g36be348cf6e_0_18#slide=id.g36be348cf6e_0_18" target="_blank">Esther Innovation Deck</a> - An introduction to being innovative with the innovation project!</li>
        </ul>
      </section>

      <section class="resource-section">
        <h2>📚 Core Season Documents</h2>
        <ul class="resource-list">
          <li><a href="https://firstinspires.blob.core.windows.net/fll/challenge/2026-27/fll-challenge-bioglow-season-overview.pdf" target="_blank">Season Overview</a> - Summary of the {season.challenge}™ theme, competition structure, and Core Values</li>
          <li><a href="https://firstinspires.blob.core.windows.net/fll/challenge/2026-27/fll-challenge-bioglow-en.pdf" target="_blank">Engineering Notebook</a> - Notebook template for documenting the team's season progress</li>
          <li><a href="https://docs.google.com/presentation/d/1FzwarsVui1aHNld41dREQT0h-MdO2Zq48Fb6U-nSf3A/edit?slide=id.g867d32a2c2_1_168#slide=id.g867d32a2c2_1_168" target="_blank">Innovation Project Worksheets</a> - Templates to guide your team through the Innovation Project process</li>
          <li><a href="https://firstinspires.blob.core.windows.net/fll/challenge/2026-27/fll-challenge-bioglow-rgr.pdf" target="_blank">Robot Game Rulebook</a> - Complete rules for the Robot Game, including scoring and mission details</li>
          <li><a href="https://firstinspires.blob.core.windows.net/fll/challenge/2026-27/interactive-rgr/index.html" target="_blank">Robot Game Rulebook (Interactive)</a> - Browsable online version of the Robot Game Rulebook</li>
          <li><a href="https://firstinspires.blob.core.windows.net/fll/challenge/2026-27/fll-challenge-bioglow-tmg.pdf" target="_blank">Team Meeting Guide</a> - Suggested meeting-by-meeting plan for running a season</li>
          <li><a href="https://firstinspires.blob.core.windows.net/fll/challenge/2026-27/fll-challenge-bioglow-updates.pdf" target="_blank">Challenge Updates</a> - Official clarifications and rule updates issued during the season</li>
          <li><a href="https://firstinspires.blob.core.windows.net/fll/challenge/2026-27/fll-challenge-bioglow-field-setup-reference-guide.pdf" target="_blank">Field Set-Up Reference Guide</a> - Instructions for assembling and placing all mission models</li>
          <li><a href="https://firstinspires.blob.core.windows.net/fll/challenge/2026-27/fll-challenge-bioglow-wireframe-grid.pdf" target="_blank">Wireframe & Grid</a> - Reference diagrams for building and placing the game field</li>
        </ul>
      </section>

      <section class="resource-section">
        <h2>🏆 Judging & Awards</h2>
        <ul class="resource-list">
          <li><a href="https://firstinspires.blob.core.windows.net/fll/challenge/2026-27/fll-challenge-bioglow-awards.pdf" target="_blank">Awards & Allocation</a> - Descriptions of awards and recognition criteria used in FLL events</li>
          <li><a href="https://firstinspires.blob.core.windows.net/fll/challenge/2026-27/fll-challenge-bioglow-judging-session-flowchart.pdf" target="_blank">Judging Session Flowchart</a> - Visual guide to the judging process and session flow</li>
          <li><a href="https://firstinspires.blob.core.windows.net/fll/challenge/2026-27/fll-challenge-bioglow-rubrics-color.pdf" target="_blank">Judging Rubrics (Color)</a> - Official judging rubrics for Core Values, Innovation Project, and Robot Design</li>
          <li><a href="https://firstinspires.blob.core.windows.net/fll/challenge/2026-27/fll-challenge-bioglow-excel-scorer.xlsm" target="_blank">Official Judging Spreadsheet</a> - Excel-based tool for recording and calculating judging results</li>
        </ul>
      </section>

      <section class="resource-section">
        <h2>🎬 Videos</h2>
        <ul class="resource-list">
          <li><a href="https://www.firstinspires.org/programs/fll/game-and-season" target="_blank">Official {season.challenge}™ Season Page</a> - Starting point for the season videos and materials. Direct video links are published by <em>FIRST</em> and are not mirrored here.</li>
        </ul>
      </section>

      <section class="resource-section">
        <h2>📎 Multimedia & Support</h2>
        <ul class="resource-list">
          <li><a href="https://firstinspires.blob.core.windows.net/fll/challenge/2026-27/fll-challenge-bioglow-multimedia-resources.pdf" target="_blank">Multimedia Resources</a> - Logos, graphics, and media resources for use in team materials</li>
          <li><a href="https://education.lego.com/en-us/downloads/spike-prime/software" target="_blank">SPIKE Prime Software</a> - Official programming environment</li>
          <li><a href="https://pybricks.com/" target="_blank">Pybricks</a> - Alternative Python-based programming for advanced users</li>
        </ul>
      </section>
    </div>
  </div>
</Layout>

<style>
  .resources-page {
    max-width: 800px;
    margin: 0 auto;
  }

  .banner {
    background: linear-gradient(135deg, var(--color-accent) 0%, #c13127 100%);
    color: white;
    padding: calc(var(--grid-unit) * 4);
    border-radius: 8px;
    text-align: center;
    margin-bottom: calc(var(--grid-unit) * 6);
  }

  .banner h1 {
    font-family: var(--font-heading-primary);
    font-size: 2.5rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin: 0 0 calc(var(--grid-unit) * 2) 0;
    color: white;
  }

  .banner-text {
    margin: 0;
    font-size: 1.125rem;
    line-height: 1.6;
  }

  .banner-text a {
    color: white;
    text-decoration: underline;
    font-weight: 500;
    transition: opacity 0.2s ease;
  }

  .banner-text a:hover {
    text-decoration: none;
    opacity: 0.8;
  }

  .resources {
    display: grid;
    gap: calc(var(--grid-unit) * 5);
  }

  .resource-section {
    background-color: var(--color-surface);
    padding: calc(var(--grid-unit) * 4);
    border-radius: 8px;
    border-left: 4px solid var(--color-accent);
    border: 2px solid var(--color-border);
  }

  .resource-section h2 {
    font-family: var(--font-heading-secondary);
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--color-text-primary);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin: 0 0 calc(var(--grid-unit) * 3) 0;
  }

  .resource-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .resource-list li {
    margin-bottom: calc(var(--grid-unit) * 2);
    padding-left: calc(var(--grid-unit) * 3);
    position: relative;
    line-height: 1.6;
    color: var(--color-text-secondary);
  }

  .resource-list li::before {
    content: "•";
    color: var(--color-accent);
    font-weight: 700;
    position: absolute;
    left: 0;
    top: 0;
  }

  .resource-list a {
    color: var(--color-accent);
    text-decoration: none;
    font-weight: 600;
    transition: color 0.2s ease;
  }

  .resource-list a:hover {
    text-decoration: underline;
    color: var(--color-text-primary);
  }

  @media (max-width: 768px) {
    .banner {
      padding: calc(var(--grid-unit) * 3);
    }

    .banner h1 {
      font-size: 2rem;
    }

    .banner-text {
      font-size: 1rem;
    }

    .resource-section {
      padding: calc(var(--grid-unit) * 3);
    }

    .resource-section h2 {
      font-size: 1.5rem;
    }
  }
</style>
