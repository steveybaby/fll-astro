---
import Layout from '../components/Layout.astro';
---

<Layout title="Photos" description="How team photos are organized and shared">
  <div class="photos-page">
    <header class="page-header">
      <h1 class="page-title">📷 Team Photos</h1>
      <p class="page-description">Visual documentation of our FLL Challenge journey</p>
      <hr class="page-rule" />
    </header>

    <div class="photos-content">
      <section class="photos-section">
        <h2>🗂️ How Photos Are Organized</h2>
        <p>
          Photos are automatically integrated into each meeting page, making it easy to see
          the visual story of our progress alongside meeting notes and assignments.
        </p>

        <div class="photo-organization">
          <div class="org-item">
            <h3>📁 Meeting Documentation</h3>
            <p>Each meeting page includes a photo gallery showing pictures from that specific session.</p>
          </div>

          <div class="org-item">
            <h3>🖼️ Interactive Galleries</h3>
            <p>Click any photo to open it in full-screen lightbox mode with navigation controls.</p>
          </div>

          <div class="org-item">
            <h3>⌨️ Keyboard Navigation</h3>
            <p>Use arrow keys to navigate between photos and Escape to close the lightbox.</p>
          </div>
        </div>
      </section>

      <section class="photos-section">
        <h2>🎯 Finding Photos</h2>
        <p>
          To view photos from our team meetings and activities, visit the individual meeting pages:
        </p>

        <div class="photo-links">
          <a href="/2025/meetings/2025-08-10-season-kickoff/" class="photo-link">
            📅 Season Kickoff Meeting
          </a>

          <a href="/2025/meetings/2025-08-17-challenge-review/" class="photo-link">
            🔧 Challenge Review Meeting
          </a>

          <a href="/meeting-plans/" class="photo-link">
            📋 View All Meetings
          </a>
        </div>
      </section>

      <section class="photos-section">
        <h2>☁️ Photo Storage System</h2>
        <p>Our photos are automatically stored and served from Cloudflare R2 for fast, reliable access:</p>

        <div class="photo-organization">
          <div class="org-item">
            <h3>🔄 Automatic Processing</h3>
            <p>Photos are automatically resized, optimized, and organized by meeting date using EXIF data.</p>
          </div>

          <div class="org-item">
            <h3>🖼️ Smart Thumbnails</h3>
            <p>4:3 aspect ratio thumbnails are generated for consistent gallery display with full-size images available.</p>
          </div>

          <div class="org-item">
            <h3>📱 Fast Loading</h3>
            <p>Photos are served from Cloudflare's global CDN for lightning-fast loading on all devices.</p>
          </div>
        </div>
      </section>

      <section class="photos-section">
        <h2>📸 Photo Guidelines</h2>
        <div class="guidelines">
          <div class="guideline">
            <h4>🎭 Team Members</h4>
            <p>We follow privacy guidelines and get permission before posting photos with team members.</p>
          </div>

          <div class="guideline">
            <h4>🤖 Robot Progress</h4>
            <p>Document robot building progress, design iterations, and successful mission runs.</p>
          </div>

          <div class="guideline">
            <h4>🎉 Team Activities</h4>
            <p>Capture team meetings, brainstorming sessions, and Core Values moments.</p>
          </div>

          <div class="guideline">
            <h4>🏆 Competitions</h4>
            <p>Document tournament experiences, presentations, and celebrations.</p>
          </div>
        </div>
      </section>
    </div>
  </div>
</Layout>

<style>
  .photos-page {
    max-width: 800px;
    margin: 0 auto;
    line-height: 1.7;
  }

  .page-header {
    text-align: center;
    margin-bottom: calc(var(--grid-unit) * 6);
  }

  .page-title {
    font-family: var(--font-heading-primary);
    font-size: 2.5rem;
    font-weight: 700;
    color: var(--color-accent);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    line-height: 1.1;
    margin-bottom: calc(var(--grid-unit) * 2);
  }

  .page-description {
    font-size: 1.1rem;
    color: var(--color-text-muted);
    margin: 0 0 calc(var(--grid-unit) * 3) 0;
  }

  .page-rule {
    height: 4px;
    background-color: var(--color-accent);
    border: none;
    width: 120px;
    margin: 0 auto;
  }

  .photos-content {
    display: grid;
    gap: calc(var(--grid-unit) * 5);
    margin-top: calc(var(--grid-unit) * 6);
  }

  .photos-section {
    background: var(--color-surface);
    padding: calc(var(--grid-unit) * 4);
    border-radius: 8px;
    border-left: 4px solid var(--color-accent);
  }

  .photos-section h2 {
    font-family: var(--font-heading-secondary);
    margin: 0 0 calc(var(--grid-unit) * 2.5) 0;
    color: var(--color-text-primary);
    font-size: 1.5em;
  }

  .photos-section p {
    color: var(--color-text-secondary);
    margin-bottom: calc(var(--grid-unit) * 2);
  }

  .photo-organization {
    display: grid;
    gap: calc(var(--grid-unit) * 2.5);
    margin-top: calc(var(--grid-unit) * 2.5);
  }

  .org-item {
    background: var(--color-background);
    padding: calc(var(--grid-unit) * 2.5);
    border-radius: 8px;
    border: 1px solid var(--color-border);
  }

  .org-item h3 {
    margin: 0 0 calc(var(--grid-unit) * 1.25) 0;
    color: var(--color-text-primary);
    font-size: 1.1em;
  }

  .org-item p {
    color: var(--color-text-muted);
    margin: 0;
  }

  .photo-links {
    display: grid;
    gap: calc(var(--grid-unit) * 2);
    margin-top: calc(var(--grid-unit) * 2.5);
  }

  .photo-link {
    display: block;
    background: var(--color-background);
    padding: calc(var(--grid-unit) * 2) calc(var(--grid-unit) * 2.5);
    border-radius: 8px;
    border: 1px solid var(--color-border);
    color: var(--color-accent);
    text-decoration: none;
    font-weight: 500;
    transition: all 0.2s;
  }

  .photo-link:hover {
    background: var(--color-accent);
    color: var(--color-background);
    transform: translateX(5px);
  }

  .guidelines {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: calc(var(--grid-unit) * 2.5);
    margin-top: calc(var(--grid-unit) * 2.5);
  }

  .guideline {
    background: var(--color-background);
    padding: calc(var(--grid-unit) * 2.5);
    border-radius: 8px;
    border: 1px solid var(--color-border);
  }

  .guideline h4 {
    margin: 0 0 calc(var(--grid-unit) * 1.25) 0;
    color: var(--color-text-primary);
    font-size: 1.1em;
  }

  .guideline p {
    color: var(--color-text-muted);
    font-size: 0.9em;
    margin: 0;
  }

  @media (max-width: 600px) {
    .page-title {
      font-size: 2em;
    }

    .photos-section {
      padding: calc(var(--grid-unit) * 2.5);
    }

    .guidelines {
      grid-template-columns: 1fr;
    }
  }
</style>
