---
/**
 * Every photo from the current season, grouped by the meeting it came from.
 *
 * This page used to explain how the photo pipeline works and contained no
 * photos at all, while the homepage's "Recently" strip linked here as "All
 * photos" — so the one link promising pictures led to a page about plumbing.
 *
 * It deliberately does not reuse R2PhotoGallery: that component hardcodes DOM
 * ids (`r2-photo-lightbox`, `r2-photo-grid`) and global handler functions, so
 * one instance per meeting would collide sixteen ways. Meeting pages keep it;
 * here each thumbnail links to its full-size image instead.
 */
import Layout from '../components/Layout.astro';
import manifest from '../data/photo-manifest.json';
import { getSeasonContent } from '../utils/season';
import { getCurrentSeason } from '../config/season';

const season = getCurrentSeason();
const meetings = await getSeasonContent('meetings');

const byMeeting: Record<string, { thumbnail: string; fullImage: string }[]> =
  (manifest as any).photosByMeeting ?? {};

const fmtDate = new Intl.DateTimeFormat('en-US', {
  weekday: 'short',
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});

// Join the manifest's date keys to this season's meetings, so each group gets a
// title and a link rather than a bare date. Keys belonging to other seasons
// fall away here, which is what keeps archive photos off this page.
const groups = meetings
  .map((m) => {
    const key = m.data.date.toISOString().slice(0, 10);
    return {
      key,
      slug: m.slug,
      title: m.data.title,
      date: m.data.date,
      photos: byMeeting[key] ?? [],
    };
  })
  .filter((g) => g.photos.length > 0)
  .sort((a, b) => b.date.getTime() - a.date.getTime());

const totalPhotos = groups.reduce((n, g) => n + g.photos.length, 0);
const hasArchivedPhotos = Object.entries(byMeeting).some(
  ([key, photos]) => photos.length > 0 && !groups.some((g) => g.key === key)
);
---

<Layout
  title="Photos"
  description={`Every photo from the ${season.teamName}'s ${season.challenge} season, grouped by meeting.`}
  showSidebar={false}
>
  <div class="shell">
    <header class="head">
      <span class="eyebrow" data-reveal>Season {season.id} · {season.challenge}</span>
      <h1 data-reveal>Photos</h1>
      {totalPhotos > 0 && (
        <p class="head__count" data-reveal data-reveal-delay="1">
          {totalPhotos} {totalPhotos === 1 ? 'photo' : 'photos'} from {groups.length}
          {groups.length === 1 ? ' meeting' : ' meetings'} so far
        </p>
      )}
    </header>

    {groups.length > 0 ? (
      groups.map((group, gi) => (
        <section class="group" aria-labelledby={`g-${group.slug}`}>
          <div class="group__head" data-reveal>
            <h2 id={`g-${group.slug}`} class="group__title">
              <a href={`/meetings/${group.slug}/`}>{group.title}</a>
            </h2>
            <p class="group__meta">
              <time datetime={group.key}>{fmtDate.format(group.date)}</time>
              <span aria-hidden="true"> · </span>
              {group.photos.length} {group.photos.length === 1 ? 'photo' : 'photos'}
            </p>
          </div>

          <ul class="grid">
            {group.photos.map((photo, i) => (
              <li data-reveal data-reveal-delay={String(Math.min((gi === 0 ? i : 0) + 1, 4))}>
                <a href={photo.fullImage} class="tile" target="_blank" rel="noopener">
                  <img
                    src={photo.thumbnail}
                    alt={`Photo from ${group.title}, ${fmtDate.format(group.date)}`}
                    loading="lazy"
                    decoding="async"
                    width="400"
                    height="300"
                  />
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    ) : (
      <p class="empty">
        No photos yet this season. They appear here automatically once they are
        synced from a meeting.
      </p>
    )}

    {hasArchivedPhotos && (
      <p class="archive-note">
        Looking for earlier seasons? Those photos live on their meeting pages in
        the <a href="/2025/">2025 archive</a>.
      </p>
    )}

    <section class="about" aria-labelledby="about-photos">
      <h2 id="about-photos" class="about__title">About team photos</h2>
      <p>
        Photos are synced automatically after each meeting and appear on that
        meeting's page as well as here. Click any photo to open it full size.
      </p>
      <p>
        We follow privacy guidelines and get permission before posting photos
        that include team members.
      </p>
    </section>
  </div>
</Layout>

<style>
  .shell {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: var(--space-xl) var(--content-padding) var(--space-2xl);
  }

  .head { margin-bottom: var(--space-xl); }
  .head h1 { margin-bottom: var(--space-2xs); }

  .head__count {
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    margin-bottom: 0;
  }

  .group { margin-bottom: var(--space-2xl); }

  .group__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-s);
    flex-wrap: wrap;
    padding-bottom: var(--space-2xs);
    border-bottom: 1.5px solid var(--color-border);
    margin-bottom: var(--space-m);
  }

  .group__title {
    font-size: var(--step-1);
    margin-bottom: 0;
  }

  .group__title a { color: var(--color-accent); }

  .group__meta {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    color: var(--color-text-muted);
    margin-bottom: 0;
  }

  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-2xs);
  }

  .grid li { margin: 0; }

  .tile {
    display: block;
    border-radius: var(--radius-m);
    overflow: hidden;
    aspect-ratio: 4 / 3;
  }

  .tile img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    margin: 0;
    border-radius: 0;
    transition: transform var(--dur-base) var(--ease-out);
  }

  .tile:hover img,
  .tile:focus-visible img { transform: scale(1.04); }

  .empty,
  .archive-note {
    color: var(--color-text-muted);
    margin-bottom: var(--space-xl);
  }

  .about {
    border-top: 1.5px solid var(--color-border);
    padding-top: var(--space-m);
  }

  .about__title { font-size: var(--step-0); }

  .about p {
    color: var(--color-text-secondary);
    font-size: var(--step--1);
    max-width: 68ch;
  }

  @media (min-width: 720px) {
    .grid { grid-template-columns: repeat(4, 1fr); gap: var(--space-s); }
  }

  @media (prefers-reduced-motion: reduce) {
    .tile:hover img,
    .tile:focus-visible img { transform: none; }
  }
</style>
